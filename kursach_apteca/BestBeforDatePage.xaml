<Page x:Class="kursach_apteca.BestBeforDatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kursach_apteca"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BestBeforDatePage" FontFamily="Times New Roman" Grid.IsSharedSizeScope="True">

    <Page.Resources>
        <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,8" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Контроль сроков годности"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#6A1B9A" />

        <Grid Grid.Row="2" Background="#6A1B9A" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" SharedSizeGroup="NameColumn" />
                <ColumnDefinition Width="1*" SharedSizeGroup="QuantityColumn" />
                <ColumnDefinition Width="1.3*" SharedSizeGroup="DateColumn" />
                <ColumnDefinition Width="1.5*" SharedSizeGroup="StatusColumn" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Название" Grid.Column="0" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Text="Количество на складе" Grid.Column="1" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Text="Срок годности" Grid.Column="2" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Text="Статус" Grid.Column="3" Style="{StaticResource TableHeaderStyle}" />
        </Grid>

        <ListView Grid.Row="3" Name="BestBeforDate"
                  BorderThickness="0"
                  SelectionChanged="BestBeforDate_SelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"
                            Background="{Binding StatusBackground}"
                            Padding="10,12" Margin="0,0,0,2">
                        <Grid> 
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" SharedSizeGroup="NameColumn" />
                                <ColumnDefinition Width="1*" SharedSizeGroup="QuantityColumn" />
                                <ColumnDefinition Width="1.3*" SharedSizeGroup="DateColumn" />
                                <ColumnDefinition Width="1.5*" SharedSizeGroup="StatusColumn" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding DrugName}" Grid.Column="0" FontSize="18"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Quantity}" Grid.Column="1" FontSize="18"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SellBy, StringFormat={}{0:dd.MM.yyyy}}" Grid.Column="2"
                                       FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Status}" Grid.Column="3" FontSize="18"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
