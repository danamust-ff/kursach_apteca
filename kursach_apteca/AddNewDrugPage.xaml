<Page x:Class="kursach_apteca.AddNewDrugPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kursach_apteca"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddNewDrugPage" FontFamily="Times New Roman" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

       

        <TextBlock Grid.Row="1" HorizontalAlignment="Center" Text="Добавление нового товара*"  FontSize="35"  FontWeight="Bold" Foreground="#6A1B9A"  Margin="0,25,0,20" />
        <Grid Grid.Row="2" Margin="30" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /> 
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Введите название товара: " Grid.Row="0" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Margin="0,0,10,0"/>
            <TextBox Name="TBNewNameDrug" Grid.Row="0" TextChanged="TBNewNameDrug_TextChanged" Grid.Column="1" FontSize="18" Width="200" HorizontalAlignment="Left" Margin="0,0,10,10"/>
            
            <TextBlock Text="Введите тип товара: " Grid.Row="1" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Margin="0,0,10,10"/>
            <ComboBox Name="CBNewTypeDrug" SelectionChanged="CBNewTypeDrug_SelectionChanged" Grid.Row="1" Grid.Column="1" FontSize="18" Width="200" HorizontalAlignment="Left" Margin="0,0,10,10">
                <TextBlock>Тип товара</TextBlock>
                <TextBlock>Таблетки</TextBlock>
                <TextBlock>Капсулы</TextBlock>
                <TextBlock>Капли</TextBlock>
                <TextBlock>Мазь</TextBlock>
                <TextBlock>Раствор</TextBlock>
                <TextBlock>Гель</TextBlock>
                <TextBlock>Сироп</TextBlock>
                <TextBlock>Порошок</TextBlock>
                <TextBlock>Крем</TextBlock>
                <TextBlock>Бальзам</TextBlock>
                <TextBlock>Лосьон</TextBlock>
            </ComboBox>
            
            <TextBlock Text="Введите вид товара: " Grid.Row="2" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Margin="0,0,10,0"/>
           <TextBox Name="TBNewViewDrug" Grid.Row="2" TextChanged="TBNewViewDrug_TextChanged" Grid.Column="1" FontSize="18" Width="200" HorizontalAlignment="Left" Margin="0,0,10,10"/>
            
            <TextBlock Text="Введите категорию товара: " Grid.Row="3" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Margin="0,0,10,0"/>
            <ComboBox Name="CBNewCategoryDrug" Grid.Row="3" Grid.Column="1" FontSize="18" Width="200" HorizontalAlignment="Left" Margin="0,0,10,10">
                <TextBlock>Категория товара</TextBlock>
                <TextBlock>Лекарства</TextBlock>
                <TextBlock>БАДы</TextBlock>
                <TextBlock>Косметика и уход</TextBlock>
            </ComboBox>
            
            <TextBlock Text="Введите стоимость товара: " Grid.Row="4" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Margin="0,0,10,0"/>
            <TextBox Name="TBNewCostDrug" Grid.Row="4" TextChanged="TBNewCostDrug_TextChanged" Grid.Column="1" FontSize="18" Width="200" HorizontalAlignment="Left" Margin="0,0,10,10"/>
            
            <TextBlock Text="Введите количество товара: " Grid.Row="5" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Margin="0,0,10,0"/>
            <TextBox Name="TBNewStockDrug" Grid.Row="5" Grid.Column="1" FontSize="18" Width="200" HorizontalAlignment="Left" Margin="0,0,10,10"/>
            
            <TextBlock Text="Введите объем товара в упаковке: " Grid.Row="6" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Margin="0,0,10,0"/>
            <TextBox Name="TBNewVolumeDrug" Grid.Row="6" Grid.Column="1" FontSize="18" Width="200" HorizontalAlignment="Left" Margin="0,0,10,10"/>
            
            <TextBlock Text="Введите дату производства: " Grid.Row="7" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Margin="0,0,10,0"/>
            <DatePicker Name="DPProductionDate"
                        Grid.Row="7"
                        Grid.Column="1"
                        FontSize="18"
                        Width="200"
                        HorizontalAlignment="Left"
                        Margin="0,0,10,10"
                        SelectedDateFormat="Short" />

            <TextBlock Text="Введите срок годности: " Grid.Row="8" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Margin="0,0,10,0"/>
            <DatePicker Name="DPSellByDate"
                        Grid.Row="8"
                        Grid.Column="1"
                        FontSize="18"
                        Width="200"
                        HorizontalAlignment="Left"
                        Margin="0,0,10,10"
                        SelectedDateFormat="Short" />
             
            <TextBlock Text="Введите место хранения: " Grid.Row="9" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Margin="0,0,10,0"/>
            <TextBox Name="TBNewPlaceDrug" Grid.Row="9" Grid.Column="1" FontSize="18" Width="200" HorizontalAlignment="Left" Margin="0,0,10,10"/>
            
            <TextBlock Text="Требовать рецепт: " Grid.Row="10" Grid.Column="0" FontSize="18" HorizontalAlignment="Left" Margin="0,0,10,0"/>
            <ComboBox Name="CBNewRequireRecipe" Grid.Row="10" Grid.Column="1" FontSize="18" Width="200" HorizontalAlignment="Left" Margin="0,0,10,10">
                <TextBlock>Да</TextBlock>
                <TextBlock>Нет</TextBlock>
            </ComboBox>

            <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,10">
                <Button Content="Сохранить"
                        Click="BtnSave_Click"
                        Width="120"
                        Padding="10,5"
                        Margin="0,0,10,0"
                        Background="#6A1B9A"
                        Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
