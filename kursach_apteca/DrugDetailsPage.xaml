<Page x:Class="kursach_apteca.DrugDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kursach_apteca"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DrugDetailsPage">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="1" HorizontalAlignment="Center"
                   Text="Информация о товаре"
                   FontSize="35"
                   FontWeight="Bold"
                   Foreground="#6A1B9A"
                   Margin="0,25,0,20" />

        <Grid Grid.Row="2" Margin="30" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="1" Text="Название:" HorizontalAlignment="Left" FontWeight="Bold"  FontSize="25" Margin="0,0,10,0" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Name}" FontSize="25" Margin="50,0,0,10" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Тип:" HorizontalAlignment="Left" FontWeight="Bold" FontSize="25" Margin="0,0,10,10" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Type}" FontSize="25" Margin="50,0,0,10" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Вид товара:" HorizontalAlignment="Left" FontWeight="Bold" FontSize="25" Margin="0,0,10,10" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ViewN}" FontSize="25" Margin="50,0,0,10" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Категория:" HorizontalAlignment="Left" FontWeight="Bold" FontSize="25" Margin="0,0,10,10" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Categoty}" FontSize="25" Margin="50,0,0,10" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Цена:" HorizontalAlignment="Left" FontWeight="Bold" FontSize="25" Margin="0,0,10,10" />
                <TextBox x:Name="TBPrice" Grid.Row="4" Grid.Column="2" FontSize="25" Margin="50,0,0,10" Padding="4,2" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="Объём упаковки:" HorizontalAlignment="Left" FontWeight="Bold" FontSize="25" Margin="0,0,10,10" />
                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Volume_per_package}" FontSize="25" Margin="50,0,0,10" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="Количество на складе:" HorizontalAlignment="Left" FontWeight="Bold" FontSize="25" Margin="0,0,10,10" />
                <TextBox x:Name="TBStock" Grid.Row="6" Grid.Column="2" FontSize="25" Margin="50,0,0,10" Padding="4,2" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="Место хранения:" HorizontalAlignment="Left" FontWeight="Bold" FontSize="25" Margin="0,0,10,10" />
                <TextBox x:Name="TBPlace" Grid.Row="7" Grid.Column="2" FontSize="20" Margin="50,0,0,10" Padding="4,2" />
                <TextBlock Grid.Row="8" Grid.Column="1" Text="Дата производства:" HorizontalAlignment="Left" FontWeight="Bold" FontSize="25" Margin="0,0,10,10" />
                <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding Production_date, StringFormat=dd.MM.yyyy}" FontSize="25" Margin="50,0,0,10" />
                <TextBlock Grid.Row="9" Grid.Column="1" Text="Срок годности:" HorizontalAlignment="Left" FontWeight="Bold" FontSize="25" Margin="0,0,10,10" />
            <TextBlock Grid.Row="9" Grid.Column="2" Text="{Binding Sell_by, StringFormat=dd.MM.yyyy}" HorizontalAlignment="Left" FontSize="25" Margin="50,0,0,10" />
            <TextBlock Grid.Row="10" Grid.Column="1" Text="По рецепту:" FontWeight="Bold" HorizontalAlignment="Left" FontSize="25" Margin="0,0,10,10" />
            <TextBlock Grid.Row="10" Grid.Column="2" HorizontalAlignment="Left" FontSize="25" Margin="50,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- По умолчанию пишем "Нет" -->
                        <Setter Property="Text" Value="Нет" />
                        <Style.Triggers>
                            <!-- Если IsPrescription == True, меняем на "Да" -->
                            <DataTrigger Binding="{Binding IsPrescription}" Value="True">
                                <Setter Property="Text" Value="Да" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Grid.Row="11" Grid.Column="2"
                    Content="Сохранить"
                    Click="BtnSave_Click"
                    Width="140"
                    Padding="10,5"
                    HorizontalAlignment="Center"
                    Background="#6A1B9A"
                    Foreground="White" />
        </Grid>
    </Grid>
</Page>
