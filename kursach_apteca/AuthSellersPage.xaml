<Page x:Class="kursach_apteca.AuthSellersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kursach_apteca"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthSellersPage" FontFamily="Times New Roman" >

    <Grid>
        <Grid Background="#F3E5F5">
            <!-- Легкий фиолетовый фон на весь экран -->
            <Grid.Resources>
                <!-- Стиль для TextBox (скругленные углы) -->
                <Style TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="White" BorderBrush="#D1C4E9" BorderThickness="1" CornerRadius="8">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Стиль для кнопок -->
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#6A1B9A"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontSize" Value="18"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#8E24AA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <!-- Карточка авторизации по центру -->
            <Border Width="400" Padding="40" Background="White" CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="20" ShadowDepth="5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Вход в систему" HorizontalAlignment="Center" FontSize="28" FontWeight="Bold" Foreground="#4A148C" Margin="0,0,0,30"/>

                    <TextBlock Text="Логин" FontSize="16" Foreground="#757575" Margin="5,0,0,5"/>
                    <TextBox Name="TBoxlog" TextChanged="TBoxlog_TextChanged" Height="45" FontSize="16" Margin="0,0,0,20"/>

             
                    <Button Name="LogIn" Content="Войти" Click="LogIn_Click" Height="45" Margin="0,0,0,15"/>
                   
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
