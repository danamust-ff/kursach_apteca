<Page x:Class="kursach_apteca.AddNewBuyersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kursach_apteca"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddNewBuyersPage" FontFamily="Times New Roman" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1" HorizontalAlignment="Center"
           Text="Создание карты лояльности для нового клиента"
           FontSize="35"
           FontWeight="Bold"
           Foreground="#6A1B9A"
           Margin="0,25,0,20" />

        <Grid Grid.Row="2" Margin="30" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
              
                <ColumnDefinition Width="480" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Введите фамилию клиента: " Grid.Row="0" Grid.Column="0" FontSize="25" HorizontalAlignment="Left" Margin="0,0,0,20" />
            <TextBox Name="TBLastName" Grid.Row="0" TextChanged="TBLastName_TextChanged" Grid.Column="1" FontSize="25" HorizontalAlignment="Left" Margin="0,0,0,10" Width="280"/>
            
            <TextBlock Text="Введите имя клиента: " Grid.Row="1" Grid.Column="0" FontSize="25" HorizontalAlignment="Left" Margin="0,0,0,20" />
            <TextBox Name="TBFirstName" Grid.Row="1" Grid.Column="1" TextChanged="TBFirstName_TextChanged" FontSize="25" HorizontalAlignment="Left" Margin="0,0,0,10" Width="280"/>
            
            <TextBlock Text="Введите отчество клиента (необязательно): " Grid.Row="2" Grid.Column="0" FontSize="25" HorizontalAlignment="Left" Margin="0,0,0,20" />
            <TextBox Name="TBPatronymicName" Grid.Row="2" Grid.Column="1" TextChanged="TBPatronymicName_TextChanged" FontSize="25" HorizontalAlignment="Left" Margin="0,0,0,10" Width="280"/>
            
            <TextBlock Text="Введите номер телефона клиента: " Grid.Row="3" Grid.Column="0" FontSize="25" HorizontalAlignment="Left" Margin="0,0,0,20" />
            <TextBox Name="TBPhone" Grid.Row="3" Grid.Column="1" FontSize="25" TextChanged="TBPhone_TextChanged" HorizontalAlignment="Left" Margin="0,0,0,10" Width="280"/>
            
            <TextBlock Text="Введите адрес клиента (необязательно): " Grid.Row="4" Grid.Column="0" FontSize="25" HorizontalAlignment="Left" Margin="0,0,0,20" />
            <TextBox Name="TBAddress" Grid.Row="4" Grid.Column="1" FontSize="25" TextChanged="TBAddress_TextChanged" HorizontalAlignment="Left" Margin="0,0,0,10" Width="280"/>

            <Button Grid.Row="11"
                    Grid.Column="1"
                    Content="Сохранить"
                    Click="BtnSave_Click"
                    Width="140"
                    Padding="10,5"
                    HorizontalAlignment="Left"
                    Background="#6A1B9A"
                    Foreground="White" />

        </Grid>
        </Grid>
</Page>
