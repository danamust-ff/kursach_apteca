<Page x:Class="kursach_apteca.addEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kursach_apteca"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="900"
      Title="addEditPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        </Grid>
        <Button Name="BtnBack"  Grid.Column="0" BorderThickness="0" Click="BtnBack_Click" Content="←" FontSize="35"  Background="Transparent"  
                Foreground="#6A1B9A"  Margin="5,-10, 0, 0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
        <TextBlock Name="TxtTitle"   Text="Редактирование лекарства" Foreground="#6A1B9A" FontSize="20"  Margin="45,2, 0,0"  />


        <StackPanel Grid.Row="1" Margin="20" Width="500" HorizontalAlignment="Center">

            <!-- Название -->
            <TextBlock Text="Название лекарства:" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,5"/>
            <TextBox Name="TxtName" FontSize="16" Padding="5"/>

            <!-- Тип (Выпадающий список) -->
            <TextBlock Text="Тип продукта:" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,5"/>
            <ComboBox Name="CmbType" FontSize="16" Padding="5">
                <ComboBoxItem Content="Таблетки"/>
                <ComboBoxItem Content="Капли"/>
                <ComboBoxItem Content="Раствор"/>
                <ComboBoxItem Content="Капсулы"/>
                <ComboBoxItem Content="Мазь"/>
            </ComboBox>

            <!-- Вид продукта (Текст) -->
            <TextBlock Text="Вид продукта:" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,5"/>
            <TextBox Name="TxtViewN" FontSize="16" Padding="5"/>

            <!-- Цена (Только цифры) -->
            <TextBlock Text="Цена (руб):" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,5"/>
            <TextBox Name="TxtCost" FontSize="16" Padding="5"/>
        </StackPanel>

        <!-- ================= 3. КНОПКА СОХРАНИТЬ ================= -->
        <Grid Grid.Row="2" Background="White">
            <Button Name="BtnSave" Click="BtnSave_Click" 
                    Content="Сохранить" FontSize="18" FontWeight="Bold"
                    Width="200" Height="40" 
                    Background="#AB47BC" Foreground="White" 
                    BorderThickness="0" Cursor="Hand"
                    HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
