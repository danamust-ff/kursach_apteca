<Page x:Class="kursach_apteca.Medicines_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:kursach_apteca"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="900"
      Title="Medicines_Page" FontFamily="Times New Roman" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="255"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="3" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="White" CornerRadius="10"  Padding="15,5"  Margin="5">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Margin="0,0,0,0">
                <TextBlock Name="FIOTB" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Name="RoleTB" FontSize="17" Foreground="Gray"/>
                </WrapPanel>
            </StackPanel>

        </Border>

        <StackPanel Background= "#F3E5F5" Margin="0,0,10,0" Grid.Column="0" Grid.RowSpan="4" Orientation="Vertical">
            <Grid >
                <Grid.RowDefinitions >
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Button Name="BtnSales" Content="Продажи" Click="BtnSales_Click"  HorizontalAlignment="Center" Grid.Row="0" FontSize="18" Style="{StaticResource RoundedButtonStyle}" Width="115" Height="60" Background="#F3E5F5" BorderThickness="0" Margin="0,100,0,0"/>
                <Button Name="BtnDrudsAdd"  Click="BtnDrudsAdd_Click"  HorizontalAlignment="Left" Grid.Row="3" Style="{StaticResource RoundedButtonStyle}" FontSize="18" Width="115" Height="60" Background="#F3E5F5" BorderThickness="0" Margin="5,30,0,0">
                    <TextBlock Text="Добавить лекарство" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
                <Button Name="BtnNewBuyers" Click="BtnNewBuyers_Click" Style="{StaticResource RoundedButtonStyle}" HorizontalAlignment="Center" Grid.Row="2" FontSize="18" Width="115" Height="60" Background="#F3E5F5" BorderThickness="0" Margin="5,30,0,0">
                    <TextBlock Text="Добавить клиента" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
                <Button Name="BtnExpiry"  Click="BtnExpiry_Click" HorizontalAlignment="Center" Grid.Row="1" FontSize="18" Width="115" Height="60" Style="{StaticResource RoundedButtonStyle}" Background="#F3E5F5" BorderThickness="0" Margin="5,30,0,0">
                    <TextBlock Text="Сроки годности" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>

                <Button  Grid.Row="5" Grid.Column="0" Width="110" HorizontalAlignment="Center" Style="{StaticResource RoundedButtonStyle}" Height="40" Margin="0,425,0,0">
                    <TextBlock Text="Техподдержка          8 800 555 35 35" TextWrapping="Wrap"  TextAlignment="Center"/>
                </Button>
            </Grid>
        </StackPanel>

        <Grid Grid.Column="2" Grid.RowSpan="4" HorizontalAlignment="Center" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Корзина" FontSize="25" />
            <ListBox Grid.Row="1" ItemsSource="{Binding CartItems, RelativeSource={RelativeSource AncestorType=Page}}" BorderBrush="#D0D0D0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <DockPanel>
                                <Button Content="×" Click="RemoveFromCart_Click" Tag="{Binding}" DockPanel.Dock="Right" Width="22" Height="22" />
                                <TextBlock Text="{Binding Drug.Name}" TextWrapping="Wrap" FontWeight="Bold" Width="135" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Кол-во:" VerticalAlignment="Center" />
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" TextChanged="CartQuantity_TextChanged" Width="45" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel DataContext="{Binding}" Margin="0,2,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Drug.IsPrescription}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Рецептурный товар — продажа только по рецепту" Foreground="#B00020" TextWrapping="Wrap" FontWeight="Bold" />
                                <TextBlock Text="ФИО врача, выдавшего рецепт:" FontSize="11" Margin="0,2,0,0" />
                                <TextBox Text="{Binding DoctorName, UpdateSourceTrigger=PropertyChanged}" ToolTip="ФИО врача, выдавшего рецепт" Margin="0,1,0,0" />
                                <TextBlock Text="Дата выдачи рецепта:" FontSize="11" Margin="0,2,0,0" />
                                <DatePicker SelectedDate="{Binding IssueDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="Дата выдачи рецепта" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Text="Телефон клиента" Margin="0,5,0,0" />
            <TextBox Grid.Row="3" x:Name="TBCustomerPhone" TextChanged="TBCustomerPhone_TextChanged" />
            <TextBlock Grid.Row="4" x:Name="CustomerStatus" Text="Введите телефон клиента" TextWrapping="Wrap" Foreground="#6A1B9A" />

            <TextBlock Grid.Row="5" Text="Продавец" Margin="0,5,0,0" />
            <ComboBox Grid.Row="6" x:Name="CBSeller" DisplayMemberPath="FullName" SelectedValuePath="SellerID" />
            <TextBlock Grid.Row="7" Text="После оплаты данные попадут в продажи" TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,0" />
            <Button Grid.Row="8" Content="Оплатить" Click="Pay_Click" Margin="0,8,0,0" Height="32" Background="#6A1B9A" Foreground="White" />
        </Grid>

        

    
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"  HorizontalAlignment="Left">
            <Grid Width="550" Height="50" Margin="10">
                <TextBox Foreground="#6A1B9A" Name="TBSearch" TextChanged="TBSearch_TextChanged" FontSize="19"  Padding="5,0,0,0" Width="550"  Height="35"></TextBox>
                <TextBlock x:Name="SearchPlaceholder" Text="Поиск по названию или виду" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"  IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>

        <ListBox x:Name="ComboType" Grid.Column="1" Grid.Row="1" SelectedIndex="0" SelectionChanged="ComboType_SelectionChanged_1" VerticalAlignment="Center" HorizontalAlignment="Right" Background="Transparent"  BorderThickness="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="Padding" Value="15,10"/>
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- Синий фон при выборе -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#6A5ACD"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <!-- Серый фон при наведении -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <!-- Элементы списка (текст) -->
            <ListBoxItem Content="Все категории" />
            <ListBoxItem Content="Лекарства" />
            <ListBoxItem Content="БАДы" />
            <ListBoxItem Content="Косметика и уход" />
        </ListBox>

        <ListView Grid.Row="3" Grid.Column="1" Name="MedicinesListView" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="10" SelectionChanged="MedicinesListView_SelectionChanged" PreviewMouseLeftButtonDown="MedicinesListView_PreviewMouseLeftButtonDown" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid Margin="15,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Левая часть — вся информация о товаре -->
                                <StackPanel Grid.Column="0" Orientation="Vertical" >
                                    <TextBlock FontSize="27" FontWeight="Bold" TextWrapping="Wrap">
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="18" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Type, Mode=OneWay}"/>
                                    <TextBlock FontSize="18" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="Объем упаковки:"/>
                                        <Run Text="{Binding Volume_per_package, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                    <TextBlock FontSize="18"  TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="Вид продукта:"/>
                                        <Run Text="{Binding ViewN, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="18" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="Количество на складе:"/>
                                        <Run Text="{Binding Stock, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="18" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="Место хранения:"/>
                                        <Run Text="{Binding Place, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Cost, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="25"/>
                                </StackPanel>

                                <!-- Правая часть — кнопка «Оформить заказ» (только для авторизованных) -->
                    <Button Grid.Column="3" Content="Добавить в чек" Click="AddToCart_Click" Margin="17" VerticalAlignment="Center" Padding="20,5" Width="150" Background="#AB47BC" Foreground="White"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        
    </Grid>
</Page>
